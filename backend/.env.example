# Copier ce fichier en ".env" et renseigner tes propres valeurs

DATABASE_URL=postgresql+psycopg2://codeci_user:motdepasse@localhost:5432/codeci_db

# Dossier de stockage des photos (en local pour le prototype)
# En production : remplacer par un stockage objet type S3/DigitalOcean Spaces
PHOTO_STORAGE_PATH=./storage/photos

# Rétention des photos (en jours) avant suppression du fichier
PHOTO_RETENTION_DAYS=90

# Rayon de tolérance GPS (en mètres) entre la position déclarée et l'EXIF de la photo
GPS_TOLERANCE_METERS=150
